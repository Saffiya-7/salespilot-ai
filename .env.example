# ─────────────────────────────────────────────────────────────────────────────
# SalesPilot AI — environment variables
# Copy this file to ".env" and fill in the values. NEVER commit .env.
# On Netlify, add the same names under:
#   Site configuration → Environment variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ───────────────────────────────────────
# Public values: safe in the browser because Row Level Security protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" key or the newer "publishable" key (starts with sb_publishable_).
# NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=

# ── Google Gemini (https://aistudio.google.com/apikey) ──────────────────────
# Server-only. Used by the Netlify Functions; never sent to the browser.
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# ── Optional: live web search for AI Lead Research ──────────────────────────
# none (default) | gemini (Grounding with Google Search, uses GEMINI_API_KEY,
# may be billed separately) | tavily (needs TAVILY_API_KEY)
# LIVE_SEARCH_PROVIDER=none
# TAVILY_API_KEY=

# ── Optional: per-user AI rate limits ───────────────────────────────────────
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_RATE_LIMIT_PER_DAY=200
